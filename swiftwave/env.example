# SwiftWave skill — credentials & config template
#
# Copy this file to ONE of (first found wins):
#   ./.env.swiftwave           <- project-local (next to where you run scripts)
#   ~/.config/swiftwave/env    <- per-user, works from anywhere
#   <skill-dir>/.env.swiftwave <- bundled fallback, works without setup
# or point the env var SW_ENV_FILE at any path.
#
# Then:  chmod 600 <file>     <- it holds secrets; keep it out of git
#
# Rules: one KEY=value per line, only SW_* keys are read, quotes are
# optional ('single' or "double" both fine), # starts a comment.
# Anything you export in the shell overrides the file.

# --- Where is SwiftWave? -------------------------------------------------
# Co-located (scripts run on the SwiftWave server): keep 127.0.0.1.
# Remote: the server's IP or hostname. Port 3333 is the default.
SW_HOST=127.0.0.1
# SW_PORT=3333
# SW_SCHEME=https        # auto-detected unless you set it (https|http)
# SW_INSECURE=1          # 1 = accept the self-signed daemon cert (default)

# --- Login --------------------------------------------------------------
# Any SwiftWave account works (v2 has no role separation — treat every
# credential as full admin). Leave SW_TOKEN empty to log in with user/pass.
SW_USER=admin
SW_PASS='change-me'
# SW_TOKEN=              # optional: an existing JWT, skips login

# --- Remote only --------------------------------------------------------
# Image registry as <host:port> used for remote docker push. Defaults to
# <SW_HOST>:3334. Must match what the server's builder derives (ask the
# server operator, or check service.management_node_address +
# local_image_registry.port in /var/lib/swiftwave/config.yml).
# SW_REGISTRY_ADDR=
